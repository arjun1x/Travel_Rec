# Copy to .env and adjust as needed. Dev works with no .env at all —
# these values match the defaults baked into docker-compose.yml and app config.

# docker-compose (postgres container)
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# docker-compose (redis container)
REDIS_PORT=6379

# backend (must agree with the values above; e.g. if POSTGRES_PORT=5433,
# change the port here too)
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
REDIS_URL=redis://localhost:6379/0

# auth — set a long random value outside dev (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me

# embeddings — optional; when unset, scripts/embed.py uses the free local
# sentence-transformers model instead of Voyage AI
# VOYAGE_API_KEY=

# LLM itineraries + assistant (milestone 6)
# ANTHROPIC_API_KEY=
